---
/*Astro Components*/
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { Icon } from "astro-icon/components";
/*Images*/
import LoungeMobile from "../../assets/images/lounge-mobile.png";
import loungeIntermediary from "../../assets/images/lounge-intermediary.png";
import loungeDesktop from "../../assets/images/lounge-desktop.png";

const imageOptimize = async (img: ImageMetadata) =>
  await getImage({ src: img, format: "webp", quality: 80 });

const mobileImg = await imageOptimize(LoungeMobile);
const intermediaryImg = await imageOptimize(loungeIntermediary);
const desktopImg = await imageOptimize(loungeDesktop);
---

<section>
  <div class="flex flex-col gap-10 max-w-400 my-20 mx-4 md:mx-12 lg:flex-row lg:justify-between lg:items-center 3xl:mx-auto">
    <div class="flex flex-col gap-10">
      <h1 class="clamp-[text,0.75rem,0.95rem] font-semibold text-orange-theme">
        ACÚSTICA QUE FAZ PARTE DA ARQUITETURA
      </h1>
      <p class="clamp-[text,3.2rem,4.5rem] tracking-tighter leading-15 lg:leading-18">
        Menos ruído. <br /> Mais espaço <br /> para sentir.
      </p>
      <p class="max-w-md mt-2 clamp-[text,1rem,1.15rem]">
        Projetamos conforto acústico para lugares onde a vida acontece. Sem
        esconder a arquitetura. Sem calar a personalidade.
      </p>
      <div class="flex gap-5">
        <a
          href="#solucoes"
          class="flex justify-center items-center gap-2 clamp-[w,15rem,18rem] h-15 text-white font-semibold bg-orange-theme rounded-lg"
        >
          Encontrar minha solução <Icon name="arrow" class="text-xl" />
        </a>
        <p class="hidden text-sm font-semibold md:block">
          Conheça o estúdio{" "}
          <Icon name="arrow" class="inline text-sm rotate-90" />
        </p>
      </div>
      <p class="clamp-[text,0.75rem,0.9rem] font-semibold">
        PARA TRABALHAR, CONVIVER E DESACELERAR.
      </p>
    </div>
    <div class="flex flex-col flex-1 gap-5 max-w-fit mx-auto lg:mx-0">
      <picture>
        <source
          srcset={mobileImg.src}
          media="(width < 30rem)"
          width={LoungeMobile.width}
          height={LoungeMobile.height}
        />
        <source
          srcset={intermediaryImg.src}
          media="(width < 64rem)"
          width={loungeIntermediary.width}
          height={loungeIntermediary.height}
        />
        <source
          srcset={desktopImg.src}
          media="(width >= 64rem)"
          width={loungeDesktop.width}
          height={loungeDesktop.height}
        />
        <img
          src={mobileImg.src}
          alt="Lounge com painéis acústicos terracota"
          width={LoungeMobile.width}
          height={LoungeMobile.height}
          loading="eager"
          fetchpriority="high"
        />
      </picture>
      <div class="flex justify-between clamp-[text,0.8rem,1rem]">
        <p>01 / O conforto também se ouve.</p>
        <p class="text-orange-theme font-semibold">RESSOA</p>
      </div>
    </div>
  </div>
  <div class="flex justify-center px-4 py-8 bg-primary md:px-12">
    <div class="w-full max-w-400">
      <p class="mb-5 clamp-[text,0.8rem,1rem] text-pale-gray">
        O QUE MUDA QUANDO O SOM ENCONTRA SEU LUGAR?
      </p>
      <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        <li>
          <h2 class="clamp-[text,1.7rem,2rem] text-white">
            Conversas, não ecos.
          </h2>
          <p class="text-seashell3">Restaurantes que aproximam.</p>
        </li>
        <li>
          <h2 class="clamp-[text,1.7rem,2rem] text-white">Foco sem esforço.</h2>
          <p class="text-seashell3">Escritórios que respeitam.</p>
        </li>
        <li>
          <h2 class="clamp-[text,1.7rem,2rem] text-white">Pausa de verdade.</h2>
          <p class="text-seashell3">Casas que acolhem.</p>
        </li>
      </ul>
    </div>
  </div>
</section>
