---
/*Astro Components*/
import SolutionsCard from "../ui/Solutions-card.astro";
/*Data*/
import { solutionsData } from "../../data/solutions.ts";
---

<section class="flex flex-col gap-10 w-full max-w-400 px-4 md:px-12 3xl:mx-auto 3xl:px-0">
  <header class="flex flex-col gap-10 w-full">
    <p class="text-base font-semibold text-orange-theme">01 / SOLUÇÕES</p>
    <div class="flex flex-col gap-5 md:flex-row md:justify-between">
      <h2 class="clamp-[text,2.5rem,2.8rem] tracking-tighter leading-12">
        Seu espaço tem
        <br /> um jeito de soar.
      </h2>
      <p class="flex-1 max-w-90 text-pewter-green">
        A gente encontra o equilíbrio entre o que você quer ver e o que precisa
        ouvir.
      </p>
    </div>
  </header>
  <ul class="grid gap-5 grid-cols-1 md:grid-cols-2">
    <SolutionsCard items={solutionsData} />
  </ul>
</section>
