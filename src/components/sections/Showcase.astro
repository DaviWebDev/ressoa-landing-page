---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import AuroraCoffeeSm from "../../assets/images/aurora-coffee-small.png";
import AuroraCoffeeBase from "../../assets/images/aurora-coffee-base.png";
import AuroraCoffeeLg from "../../assets/images/aurora-coffee-large.png";

const imageOptimize = async (img: ImageMetadata) =>
  await getImage({ src: img, format: "webp", quality: 80 });

const auroraCoffeeSm = await imageOptimize(AuroraCoffeeSm);
const auroraCoffeeBase = await imageOptimize(AuroraCoffeeBase);
const auroraCoffeeLg = await imageOptimize(AuroraCoffeeLg);
---

<section class="flex px-4 py-15 bg-primary md:px-12 3xl:px-38">
  <div class="flex flex-col gap-10 w-full max-w-7xl">
    <header class="flex flex-col gap-5 md:flex-row md:justify-between md:items-center">
      <div class="flex flex-col gap-5">
        <p class="text-base font-semibold text-[#DCC6AC]">
          02 / UM ESPAÇO, OUTRA ESCUTA
        </p>
        <h2 class="clamp-[text,1.9rem,2.8rem] font-medium tracking-tighter leading-13 text-white">
          O café continua vivo.
          <br /> O ruído não precisa.
        </h2>
      </div>
      <span class="w-fit px-5 py-2 text-sm font-semibold text-pale-gray border border-pale-gray rounded-4xl">
        PROJETO CONCEITUAL
      </span>
    </header>
    <picture class="mx-auto rounded-xl overflow-hidden">
      <source
        srcset={auroraCoffeeSm.src}
        media="(width < 30rem)"
        width={AuroraCoffeeSm.width}
        height={AuroraCoffeeSm.height}
      />
      <source
        srcset={auroraCoffeeBase.src}
        media="(30rem <= width <= 52.125rem)"
        width={AuroraCoffeeBase.width}
        height={AuroraCoffeeBase.height}
      />
      <source
        srcset={auroraCoffeeLg.src}
        media="(width >= 52.125rem)"
        width={AuroraCoffeeLg.width}
        height={AuroraCoffeeLg.height}
      />
      <img
        src={auroraCoffeeBase.src}
        alt="Interior do café aurora com baffles acústicos no teto"
        width={AuroraCoffeeBase.width}
        height={AuroraCoffeeBase.height}
        loading="lazy"
        fetchpriority="low"
        class="aspect-[1.22/1] object-cover sm:aspect-[1.89/1] 2md:aspect-[2.46/1]"
      />
    </picture>
    <div class="flex flex-col gap-10 md:flex-row md:clamp-[gap,0,20rem]">
      <div class="flex flex-col gap-2">
        <p class="text-3xl text-white">Café Aurora</p>
        <p class="text-seashell3">Hospitalidade / São Paulo</p>
      </div>
      <div class="flex flex-col gap-5 md:flex-1 md:max-w-195">
        <h3 class="text-2xl text-white">
          Mais presença à mesa. Menos voz disputando espaço.
        </h3>
        <p class="text-seashell3">
          Baffles de feltro no teto e um banco estofado absorvem as reflexões
          sem apagar a energia do salão. A paleta acolhe; a acústica deixa a
          conversa fluir.
        </p>
        <ul class="flex flex-col gap-3 text-seashell3 lg:grid lg:grid-cols-[repeat(auto-fit,minmax(200px,0.2fr))]">
          <li class="w-fit px-5 py-2 border rounded-4xl">Teto absorvente</li>
          <li class="w-fit px-5 py-2 border rounded-4xl">Texturas naturais</li>
          <li class="w-fit px-5 py-2 border rounded-4xl">Conversas próximas</li>
        </ul>
      </div>
    </div>
  </div>
</section>
