---
import Logo from "../../assets/images/ressoa-logo.svg";
import { footerData } from "../../data/footer.ts";
---

<footer class="flex justify-center py-18 px-4 text-white bg-primary md:px-12 3xl:px-0">
  <div class="flex flex-col gap-5 w-full max-w-400">
    <div class="flex flex-col gap-5 sm:flex-row sm:justify-between">
      <div class="flex flex-col gap-5">
        <a href="/" aria-label="Logo ressoa">
          <Logo width={200} height={45} />
        </a>
        <p class="text-seashell3">
          Arquitetura para ver.
          <br /> Conforto para sentir.
        </p>
      </div>
      <nav>
        <ul class="flex flex-col gap-5 sm:flex-row">
          {footerData.map(({ label, href }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="flex flex-col gap-2 pt-5 border-t border-t-pewter-green sm:flex-row sm:justify-between">
      <p>ressoa · Projeto conceitual de portfólio</p>
      <p>Design que acolhe. Som que respeita.</p>
    </div>
  </div>
</footer>

<style>
  nav ul li a {
    position: relative;
  }

  nav ul li a::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: white;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s ease;
  }

  nav ul li a:hover::after {
    transform: scale(1);
  }
</style>
